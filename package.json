{
  "name": "dp-aktivitetslogg-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "eslint .",
    "prepare": "husky install && pnpm run generate-api-types",
    "generate-api-types": "openapi-generator-cli generate",
    "port-forward": "kubectl -n teamdagpenger port-forward svc/dp-aktivitetslogg 8081:80"
  },
  "dependencies": {
    "@navikt/ds-css": "^8.16.1",
    "@navikt/ds-react": "^8.16.1",
    "@navikt/oasis": "^4.1.4",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.8.0",
    "eslint-config-next": "16.2.12",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "10.0.1",
    "@navikt/aksel": "^8.9.1",
    "@openapitools/openapi-generator-cli": "^2.31.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint"
    ]
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
